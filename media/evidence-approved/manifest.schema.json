{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Robotaxi 已批准作品媒体",
  "type": "object",
  "required": ["schemaVersion", "reviewStatus", "publicStatus", "approvalRecord", "sourceDraftManifestSha256", "projectionContract", "rows", "assets"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "reviewStatus": { "const": "approved" },
    "publicStatus": { "const": "public" },
    "approvalRecord": {
      "type": "object",
      "required": ["approvalId", "approvalStatus", "authority", "approvedAt", "scope"],
      "properties": {
        "approvalId": { "const": "robotaxi-portfolio-media-2026-07-28" },
        "approvalStatus": { "const": "approved" },
        "authority": { "const": "user" },
        "approvedAt": { "const": "2026-07-28" },
        "scope": { "const": "四项 Robotaxi 作品媒体及既定事实边界" }
      },
      "additionalProperties": false
    },
    "sourceDraftManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "projectionContract": { "type": "object" },
    "rows": { "type": "array", "minItems": 4, "maxItems": 4 },
    "assets": { "type": "array", "minItems": 4, "maxItems": 4 }
  },
  "additionalProperties": false
}
